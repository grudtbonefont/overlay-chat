<?xml version="1.0" encoding="utf-8"?>
<!-- Разрешаем HTTP к своему серверу (VPS / LAN). Без внешних CDN. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
