<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="320dp"
    android:layout_height="420dp">

    <!-- Полный чат -->
    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnLock"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="🔓"
                android:textSize="18sp"
                android:background="@drawable/bg_handle" />

            <TextView
                android:id="@+id/overlayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Overlay Chat"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="—"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnCloseOverlay"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/danger"
                android:textSize="14sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:id="@+id/tabsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabChats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Чаты"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/tabFriends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Друзья"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/tabRooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Комнаты"
                    android:textColor="@color/muted" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/listScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/messagesScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <TextView
                android:id="@+id/messagesView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:text="" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/overlayInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Сообщение…"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:background="@drawable/bg_input"
                android:padding="8dp"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="3" />

            <TextView
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="➤"
                android:textColor="@color/text"
                android:background="@drawable/bg_btn"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Компактная ручка (замок / развернуть) — поверх, всегда touchable при lock -->
    <TextView
        android:id="@+id/lockHandle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:gravity="center"
        android:text="🔒"
        android:textSize="20sp"
        android:background="@drawable/bg_handle"
        android:visibility="gone"
        android:elevation="8dp" />
</FrameLayout>
