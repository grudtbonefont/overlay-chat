{
  "name": "overlay-chat-client",
  "version": "1.0.0",
  "description": "Overlay Chat — оверлей-чат для геймеров (Electron)",
  "main": "main.js",
  "author": "Overlay Chat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.overlaychat.app",
    "productName": "Overlay Chat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1049"
    },
    "portable": {
      "artifactName": "OverlayChat-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}